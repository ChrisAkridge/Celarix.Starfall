<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Celarix.Starfall.Harness.PromptDialog"
        Title="Starfall"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" MaxWidth="480" />
    <TextBox x:Name="AnswerBox" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="OkButton_Click" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="CancelButton_Click" />
    </StackPanel>
  </StackPanel>
</Window>
